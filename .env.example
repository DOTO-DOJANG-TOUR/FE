# Expo에서 클라이언트 코드로 노출되는 값은 EXPO_PUBLIC_ 접두사가 필요합니다.
# 이 파일을 복사해 .env로 만들고 실제 값을 채워넣으세요. (.env는 git에 커밋되지 않습니다)

# 백엔드 API 서버 주소
EXPO_PUBLIC_API_BASE_URL=

# Google 네이티브 로그인 SDK
# 백엔드 GOOGLE_OIDC_CLIENT_ID와 같은 Web OAuth Client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Kakao Android 네이티브 로그인 SDK
# Kakao Developers > 앱 > 앱 키의 Native App Key
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Kakao Developers에서 카카오 로그인과 OpenID Connect(OIDC)를 활성화하고,
# Android 플랫폼에 패키지명(com.dotofe)과 현재 빌드의 키 해시를 등록해야 합니다.
