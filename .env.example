# Expo에서 클라이언트 코드로 노출되는 값은 EXPO_PUBLIC_ 접두사가 필요합니다.
# 이 파일을 복사해 .env로 만들고 실제 값을 채워넣으세요. (.env는 git에 커밋되지 않습니다)

# 백엔드 API 서버 주소
EXPO_PUBLIC_API_BASE_URL=

# Google 네이티브 로그인 SDK
# 백엔드 GOOGLE_OIDC_CLIENT_ID와 같은 Web OAuth Client ID
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Kakao Developers REST API 키
EXPO_PUBLIC_KAKAO_CLIENT_ID=

# Kakao Developers에 등록할 HTTPS 콜백 주소
# 콜백은 code/state를 앱 스킴(dotofe://oauth/kakao)으로 중계해야 합니다.
EXPO_PUBLIC_KAKAO_REDIRECT_URI=

# 모바일 앱에는 OAuth Client Secret을 절대 넣지 않습니다.
